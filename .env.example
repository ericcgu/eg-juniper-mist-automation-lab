# ==============================================================================
# Juniper Mist API Configuration
# ==============================================================================
# 
# This file contains the configuration for authenticating with the Mist API.
# Copy this file to .env and fill in your actual credentials.
#
# IMPORTANT: Never commit the .env file to version control!
#
# ==============================================================================

# ------------------------------------------------------------------------------
# API Token (Required)
# ------------------------------------------------------------------------------
# Your Mist API token for authentication. This is the ONLY required credential.
#
# HOW TO GENERATE A MIST API TOKEN:
#
# Step 1: Log in to Mist
#   - Navigate to https://manage.mist.com
#   - Log in with your Mist credentials
#
# Step 2: Navigate to API Tokens
#   - Click on your organization name in the top-left corner
#   - Select "Organization" from the dropdown menu
#   - Click "Settings" in the left sidebar
#   - Click "API Tokens" tab
#
# Step 3: Create a New Token
#   - Click the "Create Token" button
#   - Enter a descriptive name (e.g., "Automation Lab Token")
#   - Set the token privileges:
#     * Scope: "Organization" (or "Global" for multi-org access)
#     * Role: "Admin" (required for full API access)
#   - Click "Create"
#
# Step 4: Copy the Token
#   - IMPORTANT: Copy the token immediately - it will only be shown once!
#   - Paste it below, replacing "your_api_token_here"
#   - Store it securely (password manager recommended)
#
# Step 5: Test the Token (Optional)
#   - You can test your token with curl:
#     curl -H "Authorization: Token YOUR_TOKEN" https://api.mist.com/api/v1/self
#
# Token Format: Usually starts with "eyJ..." (JWT format)
# Token Length: Typically 200+ characters
#
# Troubleshooting:
#   - If you get 401 errors, verify the token is copied correctly
#   - Ensure there are no extra spaces before or after the token
#   - Check that the token hasn't expired (tokens don't expire by default)
#   - Verify the token has the correct privileges (Admin role)
#
MIST_API_TOKEN=your_api_token_here
